{
    "name": "dvsa/mot-cpms-common",
    "description": "Contains common code shared by CPMS projects",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "laminas/laminas-mvc": "^3.3.0",
        "laminas/laminas-inputfilter": "^2.12",
        "laminas/laminas-servicemanager": "^3.7",
        "dvsa/mot-logger": "^3.3.1",
        "laminas/laminas-authentication": "^2.8",
        "laminas/laminas-router": "^3.4",
        "laminas/laminas-json": "^3.3",
        "laminas/laminas-dependency-plugin": "^2.6.0",
        "laminas-api-tools/api-tools-versioning": "^1.4"
    },
    "require-dev": {
        "captainhook/captainhook": "^5.16",
        "captainhook/plugin-composer": "^5.3",
        "dvsa/coding-standards": "^2.1",
        "friendsofphp/php-cs-fixer": "^3.95",
        "laminas/laminas-component-installer": "^3.4.0",
        "laminas/laminas-test": "^4.0.0",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^9.5",
        "squizlabs/php_codesniffer": "^4.0.2.0",
        "vimeo/psalm": "^6.13"
    },
    "autoload": {
        "psr-4": {
            "CpmsCommon\\": "src/CpmsCommon/"
        },
        "classmap": [
            "./Module.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "CpmsCommonTest\\": "test/CpmsCommonTest/"
        },
        "classmap": [
            "./test/CpmsCommonTest/Module.php"
        ]
    },
    "scripts": {
        "test": [
            "vendor/bin/phpunit"
        ],
        "phpcs": [
            "vendor/bin/phpcs"
        ],
        "phpcs:fix": [
            "vendor/bin/phpcbf"
        ],
        "phpstan": [
            "vendor/bin/phpstan --memory-limit=512M"
        ],
        "psalm": [
            "vendor/bin/psalm --no-cache"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "allow-plugins": {
            "laminas/laminas-dependency-plugin": true,
            "laminas/laminas-component-installer": true,
            "captainhook/plugin-composer": true
        }
    }
}
